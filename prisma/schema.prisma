// ============================================================================
// FreelancerHub - Esquema de Base de Datos con Prisma ORM
// Documentación oficial: https://pris.ly/d/prisma-schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS (Tipos Enumerados)
// ----------------------------------------------------------------------------

/// Proveedor de autenticación utilizado por el usuario
enum AuthProvider {
  LOCAL   // Registro tradicional con email y contraseña
  GOOGLE  // Autenticación federada mediante Google OAuth2
  APPLE   // Autenticación federada mediante Apple ID
}

/// Rol del usuario en la plataforma FreelancerHub
enum UserRole {
  CLIENT      // Cliente / Contratante que publica proyectos
  FREELANCER  // Profesional independiente que ofrece servicios
  ADMIN       // Administrador con permisos de gestión en la plataforma
}

// ----------------------------------------------------------------------------
// MODELOS DE DATOS (Entidades / Tablas)
// ----------------------------------------------------------------------------

/// ============================================================================
/// Modelo: User
/// Tabla en BD: `users`
/// Propósito: Entidad central de cuentas y credenciales de acceso.
/// ============================================================================
model User {
  /// Identificador único universal (UUID v4)
  id               String       @id @default(uuid()) @db.Uuid

  /// Correo electrónico único del usuario (usado para login y notificaciones)
  email            String       @unique @db.VarChar(255)

  /// Hash seguro de contraseña (bcrypt/argon2). Nullable para logins OAuth puros
  passwordHash     String?      @map("password_hash") @db.VarChar(255)

  /// Proveedor de identidad que registró o autenticó al usuario
  authProvider     AuthProvider @default(LOCAL) @map("auth_provider")

  /// Identificador asignado por el proveedor OAuth (sub de Google/Apple)
  authProviderId   String?      @unique @map("auth_provider_id") @db.VarChar(255)

  /// Rol asignado dentro de la plataforma
  role             UserRole     @default(FREELANCER)

  /// Indica si el correo electrónico ha sido confirmado
  isEmailVerified  Boolean      @default(false) @map("is_email_verified")

  /// Estado de actividad de la cuenta (permite suspender o desactivar usuarios)
  isActive         Boolean      @default(true) @map("is_active")

  /// Fecha y hora de creación del registro
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Fecha y hora de la última modificación del registro
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  /// Relación 1 a 1: Cada usuario tiene exactamente un perfil detallado
  profile          Profile?

  /// Relación 1 a N: Un usuario puede registrar múltiples métodos de pago
  paymentMethods   PaymentMethod[]

  projects         Project[]

  proposals        Proposal[]

  @@map("users")
}

/// ============================================================================
/// Modelo: Profile
/// Tabla en BD: `profiles`
/// Propósito: Información personal, profesional y biográfica del usuario.
/// ============================================================================
model Profile {
  /// Identificador único del perfil
  id          String   @id @default(uuid()) @db.Uuid

  /// Clave foránea única vinculada a la tabla `users` (garantiza relación 1:1)
  userId      String   @unique @map("user_id") @db.Uuid

  /// Primer nombre o nombres de pila
  firstName   String   @map("first_name") @db.VarChar(100)

  /// Apellidos
  lastName    String   @map("last_name") @db.VarChar(100)

  /// Biografía o resumen profesional
  bio         String?  @db.Text

  /// Teléfono de contacto
  phone       String?  @db.VarChar(25)

  /// URL de la imagen de avatar o foto de perfil
  avatarUrl   String?  @map("avatar_url") @db.VarChar(500)

  /// Título profesional o especialidad (ej. Full Stack Developer)
  professionalTitle String? @map("professional_title") @db.VarChar(150)

  /// Tarifa por hora en USD
  hourlyRate        Float?  @map("hourly_rate")

  /// Fecha y hora de creación del perfil
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Fecha y hora de la última actualización
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  /// Usuario propietario del perfil (si se elimina el usuario, se elimina el perfil)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Relación 1 a N con tabla intermedia: Habilidades asociadas al perfil
  skills      ProfileSkill[]

  /// Relación 1 a N: Proyectos destacados del portafolio del perfil
  portfolioItems PortfolioItem[]

  @@map("profiles")
}

/// ============================================================================
/// Modelo: PortfolioItem
/// Tabla en BD: `portfolio_items`
/// Propósito: Proyectos y trabajos destacados agregados al portafolio del freelancer.
/// ============================================================================
model PortfolioItem {
  /// Identificador único del proyecto
  id          String   @id @default(uuid()) @db.Uuid

  /// Clave foránea vinculada al perfil dueño del proyecto
  profileId   String   @map("profile_id") @db.Uuid

  /// Título del proyecto
  title       String   @db.VarChar(150)

  /// Descripción del trabajo realizado y tecnologías
  description String   @db.Text

  /// Enlace web del proyecto (demo, repo, live)
  projectUrl  String   @map("project_url") @db.VarChar(500)

  /// Enlace a captura o imagen destacada del proyecto
  imageUrl    String?  @map("image_url") @db.VarChar(500)

  /// Fecha y hora de creación
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Fecha y hora de la última modificación
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portfolio_items")
}

/// ============================================================================
/// Modelo: Skill
/// Tabla en BD: `skills`
/// Propósito: Catálogo global de habilidades técnicas y blandas disponibles.
/// ============================================================================
model Skill {
  /// Identificador único de la habilidad
  id          String   @id @default(uuid()) @db.Uuid

  /// Nombre legible de la habilidad (ej. "React", "PostgreSQL", "Figma")
  name        String   @unique @db.VarChar(100)

  /// Identificador amigable para URLs y búsquedas (ej. "react", "postgresql")
  slug        String   @unique @db.VarChar(100)

  /// Categoría a la que pertenece (ej. "Desarrollo Web", "Diseño UI/UX", "DevOps")
  category    String   @db.VarChar(100)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  /// Perfiles que poseen esta habilidad (a través de la tabla intermedia)
  profiles    ProfileSkill[]

  projects    ProjectSkill[]

  @@map("skills")
}

/// ============================================================================
/// Modelo: ProfileSkill
/// Tabla en BD: `profile_skills`
/// Propósito: Tabla intermedia (Join Table) para la relación N:M entre Profile y Skill.
/// ============================================================================
model ProfileSkill {
  /// Clave foránea al perfil
  profileId   String   @map("profile_id") @db.Uuid

  /// Clave foránea a la habilidad
  skillId     String   @map("skill_id") @db.Uuid

  /// Fecha y hora en la que el usuario agregó la habilidad a su perfil
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// Clave primaria compuesta por (profile_id, skill_id) que evita duplicados
  @@id([profileId, skillId])
  @@map("profile_skills")
}

/// ============================================================================
/// Modelo: PaymentMethod
/// Tabla en BD: `payment_methods`
/// Propósito: Registro de métodos de pago (tarjetas/cuentas) tokenizados mediante pasarela.
/// ============================================================================
model PaymentMethod {
  /// Identificador único del método de pago
  id                String   @id @default(uuid()) @db.Uuid

  /// Clave foránea del usuario dueño de este método de pago
  userId            String   @map("user_id") @db.Uuid

  /// ID del cliente en la pasarela de pagos (ej. Stripe: `cus_xxx`, Openpay, etc.)
  gatewayCustomerId String   @map("gateway_customer_id") @db.VarChar(255)

  /// Token o ID de la tarjeta en la pasarela (ej. `pm_xxx` o `card_xxx`). NUNCA se guardan números completos
  gatewayToken      String   @map("gateway_token") @db.VarChar(255)

  /// Marca o franquicia de la tarjeta (ej. "visa", "mastercard", "amex")
  cardBrand         String   @map("card_brand") @db.VarChar(50)

  /// Últimos 4 dígitos de la tarjeta para visualización del usuario
  last4             String   @db.VarChar(4)

  /// Mes de expiración de la tarjeta (1-12)
  expMonth          Int      @map("exp_month")

  /// Año de expiración de la tarjeta (ej. 2028)
  expYear           Int      @map("exp_year")

  /// Indica si es el método de pago preferido/predeterminado del usuario
  isDefault         Boolean  @default(false) @map("is_default")

  /// Fecha y hora en la que se vinculó el método de pago
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}


// ----------------------------------------------------------------------------
// MODULO INTERNO DE GESTION DE TAREAS (MINI-JIRA EQUIPO)
// Completamente aislado del flujo y logica de produccion
// ----------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// ============================================================================
/// Modelo: InternalTask
/// Tabla en BD: `internal_tasks`
/// Propósito: Tablero Kanban interno para asignación de tareas del equipo dev.
/// ============================================================================
model InternalTask {
  /// Identificador único de la tarea
  id          String       @id @default(uuid()) @db.Uuid

  /// Título conciso de la tarea
  title       String       @db.VarChar(200)

  /// Descripción o requerimientos de la tarea
  description String?      @db.Text

  /// Estado en el tablero Kanban
  status      TaskStatus   @default(TODO)

  /// Prioridad de la tarea
  priority    TaskPriority @default(MEDIUM)

  /// Miembro asignado (Paulo, Diego, Karla, Christian, Axel, Uriel)
  assignee    String       @db.VarChar(50)

  /// Creador / Administrador que asignó la tarea
  createdBy   String       @default("Paulo") @map("created_by") @db.VarChar(50)

  /// Fecha límite opcional de entrega
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)

  /// Fecha de creación
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Fecha de última actualización
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assignee])
  @@index([status])
  @@map("internal_tasks")
}

/// ============================================================================
/// Modelo: InternalMember
/// Tabla en BD: `internal_members`
/// Propósito: Credenciales auto-gestionadas por los devs del equipo (Diego, Karla, etc.)
/// ============================================================================
model InternalMember {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  password  String   @db.VarChar(100)
  role      String   @default("DEV") @db.VarChar(20) // ADMIN o DEV
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("internal_members")
}

enum ProjectStatus {
  ACTIVE // Convocatoria activa
  CLOSED
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  title         String        @db.VarChar(150)
  description   String        @db.Text
  budget        Decimal       @db.Decimal(12, 2)
  estimatedDate DateTime      @map("estimated_date") @db.Timestamptz(6)
  status        ProjectStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  client        User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  skills        ProjectSkill[]
  proposals     Proposal[]

  @@index([clientId])
  @@index([status])
  @@index([budget])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("projects")
}

model ProjectSkill {
  projectId String   @map("project_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@index([projectId])
  @@map("project_skills")
}

// ----------------------------------------------------------------------------
// MODULO DE PROPUESTAS, COTIZACIONES E HITOS (HU-03 / HU-04)
// ----------------------------------------------------------------------------

enum ProposalStatus {
  PENDING   // Propuesta en espera de revisión por el cliente
  ACCEPTED  // Propuesta aprobada por el cliente para formalizar contrato
  REJECTED  // Propuesta declinada
}

/// ============================================================================
/// Modelo: Proposal
/// Tabla en BD: `proposals`
/// Propósito: Ofertas económicas enviadas por freelancers para una convocatoria.
/// ============================================================================
model Proposal {
  /// Identificador único de la propuesta
  id            String         @id @default(uuid()) @db.Uuid

  /// Convocatoria a la que se postula
  projectId     String         @map("project_id") @db.Uuid

  /// Freelancer que presenta la propuesta
  freelancerId  String         @map("freelancer_id") @db.Uuid

  /// Carta de presentación o justificación técnica
  coverLetter   String         @map("cover_letter") @db.Text

  /// Monto total cotizado (suma de hitos)
  totalPrice    Decimal        @map("total_price") @db.Decimal(12, 2)

  /// Tiempo total estimado de entrega en días naturales
  estimatedDays Int            @map("estimated_days")

  /// Estado de la propuesta
  status        ProposalStatus @default(PENDING)

  /// Fecha de registro de la postulación
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Fecha de última actualización de la postulación
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer    User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  milestones    MilestoneQuote[]

  /// Regla anti-abuso a nivel de persistencia: un freelancer solo puede tener 1 propuesta por proyecto
  @@unique([projectId, freelancerId], name: "unique_project_freelancer_proposal")
  @@index([projectId])
  @@index([freelancerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("proposals")
}

/// ============================================================================
/// Modelo: MilestoneQuote
/// Tabla en BD: `milestone_quotes`
/// Propósito: Desglose de hitos cotizados dentro de una propuesta económica.
/// ============================================================================
model MilestoneQuote {
  /// Identificador único del hito cotizado
  id           String    @id @default(uuid()) @db.Uuid

  /// Propuesta a la que pertenece el hito
  proposalId   String    @map("proposal_id") @db.Uuid

  /// Nombre conciso del entregable / hito
  title        String    @db.VarChar(150)

  /// Detalle o criterios de aceptación del entregable
  description  String?   @db.Text

  /// Monto económico asignado a este hito específico
  amount       Decimal   @db.Decimal(12, 2)

  /// Días estimados para completar este hito
  deliveryDays Int       @map("delivery_days")

  /// Orden secuencial del hito en el plan de trabajo (1, 2, 3...)
  order        Int       @default(1)

  /// Fecha de registro del hito
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // --------------------------------------------------------------------------
  // RELACIONES
  // --------------------------------------------------------------------------

  proposal     Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([proposalId, order])
  @@map("milestone_quotes")
}
